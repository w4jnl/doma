# Copy to .env next to compose.yaml and fill in. Nothing here is read by
# doma itself except DOMA_METRICS_TOKEN; the rest names the hosts and
# feeds Traefik and Authelia.
DOMA_HOST=doma.example.com
AUTH_HOST=auth.example.com
COOKIE_DOMAIN=example.com              # Authelia's session cookie covers both hosts
ACME_EMAIL=you@example.com

# LLDAP, already running: the docker network it is on, how Authelia
# reaches it, the base DN, and the password of its service user
# uid=authelia (read-only is enough; password reset is off).
LLDAP_NETWORK=lldap
LLDAP_ADDRESS=ldap://lldap:3890
LLDAP_BASE_DN=dc=example,dc=com
LLDAP_AUTHELIA_PASSWORD=change-me

# Authelia's own secrets: long random strings, for example
#   openssl rand -hex 32
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-change-me-change-me-change-me

# /metrics stays open to the network; with a token set it asks for
# Authorization: Bearer <token>.
DOMA_METRICS_TOKEN=change-me
