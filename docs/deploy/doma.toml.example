# doma.toml: every key can also be set as DOMA_SECTION_KEY in the environment, and a
# string value of the form "env:NAME" is read from that variable. /admin/server shows
# the effective, redacted configuration. The values here are the defaults, with
# production paths.

[server]
listen = ":8080"
base_url = "https://doma.example.com"   # invite and guest links, APNs payload, signed photo URLs
trusted_proxies = ["10.0.0.0/8"]

[db]
path = "/var/lib/doma/doma.db"

[photos]
dir = "/var/lib/doma/photos"
max_bytes_per_upload = "8MB"

[sync]
max_events_per_response = 500
replay_limit = 5000                     # older cursors get a snapshot first

[push]
enabled = false
key_file = "/var/lib/doma/apns.p8"      # encrypted at rest after first start
key_id = ""
team_id = ""
topic = "nl.w4j.doma"                   # the app's bundle id

[invites]
default_days = 7
guest_default_days = 7

[retention]
events_days = 365
photos_per_spot = 5
snapshot_hour = 3                       # server local time

[defaults]
staleness_days = 60

[log]
level = "info"
format = "json"

[metrics]
token = ""                              # "env:DOMA_METRICS_TOKEN" keeps it out of the file

[secrets]
key_file = "/var/lib/doma/secret.key"

[vision]
enabled = false                         # a vision model looks at new photos and proposes flag changes
url = ""                                # an OpenAI-compatible endpoint, e.g. http://ollama:11434/v1; the only other outbound call
model = ""                              # e.g. qwen2.5vl
api_key = ""                            # "env:DOMA_VISION_API_KEY" if the endpoint wants one
timeout_seconds = 60

[admin]
auth = "password"                       # or "proxy": the reverse proxy in front (Authelia) signs the admin in
# proxy_cidrs = ["172.16.0.0/12"]        # the proxy's addresses; Remote-User counts from nowhere else
# proxy_secret = "env:DOMA_ADMIN_PROXY_SECRET"   # the proxy adds it in X-Auth-Proxy-Secret on every request
# proxy_logout_url = "https://auth.example.com/logout?rd=https://doma.example.com"
